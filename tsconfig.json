{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@pages": ["./src/pages/"],
      "@navigation": ["./src/navigation/"],
      "@constants": ["./src/constants/"],
      "@layout": ["./src/layout/"],
      "@types": ["./src/types/"],
      "@statics": ["./src/statics/"],
      "@services": ["./src/services/"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "src/types/declaration.d.ts"]
}
